WS_PORT=8080
UDP_PORT=20777
HTTP_PORT=3001

ANTHROPIC_API_KEY=

# Demo mode (see README, "Demo mode"). Leave DEMO_MODE unset for local mode.
# In demo mode the three ports above are not read, and ANTHROPIC_API_KEY and
# DB_PATH must not be set: the server refuses to start with either.
# DEMO_MODE=true
# PORT=10000
# DEMO_ALLOWED_ORIGIN=http://localhost:5173
# DEMO_MAX_CONNECTIONS=5
# DEMO_MAX_CONNECTION_MINUTES=5
# DEMO_WS_COMPRESSION=true
# DEMO_RECORDING_PATH=recordings/demo-interlagos-tt-20hz-laps6-8.jsonl
# DEMO_SEED_PATH=demo/coach-seed.json
